---
// One celebration, on an arch-topped card: its line drawing, number and name, the day and hour, what to wear, and
// the way there and the date for the calendar.
import RiteTokens from './RiteTokens.astro';
import type { WeddingEvent } from '../data/schema';
import { archTop, icon } from '../art/sunrise';
import { T, num, viewOf } from '../data/i18n';
interface Props { ev: WeddingEvent; n: number }
const { ev, n } = Astro.props;
const view = viewOf(Astro.url), t = T(view), e = t.ev[ev.id];
/* the celebration's number: Devanagari, except on the English page */
const no = view === 'en' ? '0' + n : '०' + num('hi', n);
---
<article class={'chapter arch ch-' + ev.id} data-event={ev.id}>
  <Fragment set:html={archTop(false)} />
  <span class="ch-ic" aria-hidden="true" set:html={icon(ev.id, 40)}></span>
  <div class="arch-body">
    <header class="ch-head">
      <p class="ch-no"><span class="num" lang={view === 'en' ? undefined : 'hi'}>{no}</span>{e.dn.map((d, i) => <Fragment>{i > 0 && ' · '}<span lang={d.lang}>{d.t}</span></Fragment>)}</p>
      <h3>{e.name}</h3>
    </header>
    <div class="ch-text">
      <p class="story">{e.story}</p>
      <dl>
        <div><dt>{t.schedule.when}</dt><dd>{e.when}</dd></div>
        <div><dt>{t.schedule.where}</dt><dd>{t.venue}</dd></div>
        <div><dt>{t.schedule.wear}</dt><dd><span class="swatch" style={'--sw:' + ev.swatch.bg}></span>{e.dress}</dd></div>
      </dl>
      <RiteTokens ev={ev} />
    </div>
  </div>
</article>
