---
// One celebration: its number and name, its painting to look into, then when, where and what to wear.
import RiteTokens from './RiteTokens.astro';
import Tour from './Tour.astro';
import type { WeddingEvent } from '../data/schema';
import { T, num, viewOf } from '../data/i18n';
interface Props { ev: WeddingEvent; n: number }
const { ev, n } = Astro.props;
const view = viewOf(Astro.url), t = T(view), e = t.ev[ev.id];
/* the chapter's number: Devanagari, except on the English page */
const no = view === 'en' ? '0' + n : '०' + num('hi', n);
---
<article class={'chapter ch-' + ev.id} data-event={ev.id}>
  <header class="ch-head">
    <p class="ch-no reveal"><span class="num" lang={view === 'en' ? undefined : 'hi'}>{no}</span>{e.dn.map((d, i) => <Fragment>{i > 0 && ' · '}<span lang={d.lang}>{d.t}</span></Fragment>)}</p>
    <h3 class="reveal">{e.name}</h3>
  </header>
  <Tour id={ev.id} />
  <div class="ch-text">
    <p class="story reveal">{e.story}</p>
    <dl class="reveal">
      <div><dt>{t.schedule.when}</dt><dd>{e.when}</dd></div>
      <div><dt>{t.schedule.where}</dt><dd>{t.venue}</dd></div>
      <div><dt>{t.schedule.wear}</dt><dd><span class="swatch" style={'--sw:' + ev.swatch.bg}></span>{e.dress}</dd></div>
    </dl>
    <RiteTokens ev={ev} />
  </div>
</article>
