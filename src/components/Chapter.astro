---
// One celebration: its number and name, its painting to look into, then when, where and what to wear.
import RiteTokens from './RiteTokens.astro';
import Tour from './Tour.astro';
import type { WeddingEvent } from '../data/schema';
import { copy, venue } from '../data/wedding';
interface Props { ev: WeddingEvent; n: number }
const { ev, n } = Astro.props;
const DEV = '०१२३४५६७८९';
---
<article class={'chapter ch-' + ev.id} data-event={ev.id}>
  <header class="ch-head">
    <p class="ch-no reveal"><span class="num" lang="hi">{DEV[0] + DEV[n]}</span>{ev.dn.map((d, i) => <Fragment>{i > 0 && ' · '}<span lang={d.lang}>{d.text}</span></Fragment>)}</p>
    <h3 class="reveal">{ev.name.en}</h3>
  </header>
  <Tour id={ev.id} />
  <div class="ch-text">
    <p class="story reveal">{ev.story}</p>
    <dl class="reveal">
      <div><dt>{copy.schedule.when}</dt><dd>{ev.when}</dd></div>
      <div><dt>{copy.schedule.where}</dt><dd>{venue.full}</dd></div>
      <div><dt>{copy.schedule.wear}</dt><dd><span class="swatch" style={'--sw:' + ev.swatch.bg}></span>{ev.dress}</dd></div>
    </dl>
    <RiteTokens ev={ev} />
  </div>
</article>
