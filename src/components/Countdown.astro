---
import Parts from './Parts.astro';
import { dates } from '../data/wedding';
import { T, viewOf } from '../data/i18n';
const t = T(viewOf(Astro.url));
const ids = ['d', 'h', 'm', 's'];
---
<div class="count" id="count" data-target={dates.countdown}>
  <p class="eyebrow"><Parts parts={t.count.eyebrow} /></p>
  <div class="units">
    {ids.map((k, i) => <div class="unit"><b id={'cd-' + k}>–</b><i>{t.count.units[i]}</i></div>)}
  </div>
  <span class="count-when">{t.count.when}</span>
</div>
