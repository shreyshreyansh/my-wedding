---
// The music bell: a kajal ghanti on a zari ring, top right. Only there when the couple's recording exists.
import { copy, music } from '../data/wedding';
---
{music.src && (
  <div class="controls" id="controls" hidden>
    <audio id="music" preload="none" src={music.src} data-loop={music.loop ? '1' : ''}></audio>
    <button type="button" class="bell-btn" id="bellBtn" aria-label={copy.controls.muteOff} data-on={copy.controls.muteOff} data-off={copy.controls.muteOn}>
      <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
        <path d="M16 3v3" stroke="#C9A04A" stroke-width="2" stroke-linecap="round"/>
        <path d="M16 6c-5 0-8 4-8 9v5l-2 3h20l-2-3v-5c0-5-3-9-8-9Z" fill="#C9A04A"/>
        <path d="M16 6c5 0 8 4 8 9v5l2 3H16Z" fill="#F2D98C"/>
        <path d="M9 18h14" stroke="#2B211B" stroke-width="1.2" stroke-dasharray="1 1.6"/>
        <circle cx="16" cy="26.5" r="2.4" fill="#B3261E"/>
        <path class="bell-wave" d="M27 10c1.5 1.4 2.3 3.2 2.3 5M5 10c-1.5 1.4-2.3 3.2-2.3 5" stroke="#F2D98C" stroke-width="1.6" fill="none" stroke-linecap="round"/>
        <path class="bell-slash" d="M5 27 27 5" stroke="#B3261E" stroke-width="3" stroke-linecap="round"/>
      </svg>
    </button>
    <span class="bell-hint plate" aria-hidden="true">{copy.controls.hint}</span>
  </div>
)}
