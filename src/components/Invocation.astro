---
// ॥ श्री गणेशाय नमः ॥ — every invitation begins with Ganesha: a Pahari painting of Indra bowing to him, to look into.
import Tour from './Tour.astro';
import { copy } from '../data/wedding';
---
<section id="invocation" aria-labelledby="ivTitle">
  <div class="iv-text">
    <p id="ivTitle" lang="hi" class="iv-inv reveal">{copy.invocation.invocation}</p>
    <p class="iv-line reveal">{copy.invocation.line}</p>
  </div>
  <Tour id="ganesha" />
</section>
