---
// Two invocations, his family's and hers, side by side and equal, with one blessing beneath that both can say;
// then a Mithila Ganesha and a Buddha painted at Ajanta to look into.
import Tour from './Tour.astro';
import { copy } from '../data/wedding';
---
<section id="invocation" aria-labelledby="ivTitle">
  <div class="iv-text">
    <p id="ivTitle" class="iv-pair reveal"><span lang="hi">{copy.invocation.his}</span><i class="leaf" aria-hidden="true"></i><span lang="pi">{copy.invocation.hers}</span></p>
    <p lang="pi" class="iv-inv reveal">{copy.invocation.blessing}</p>
    <p class="iv-line reveal">{copy.invocation.line}</p>
  </div>
  <Tour id="invocation" />
</section>
