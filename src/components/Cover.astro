---
// The antarpat: a real silk held between the families until the guest taps the gold medallion woven into it.
// The silk is the 19th-century brocade in src/data/art.json ("silk"); the medallion is the seal.
import Art from './Art.astro';
import { couple, copy, dates, venue } from '../data/wedding';
---
<div id="cover" role="dialog" aria-modal="true" aria-labelledby="cvTitle">
  <div class="cloth">
    <Art id="silk" crop="tall" wide="wide" eager class="cv-silk" alt="" />
    <div class="cv-shade" aria-hidden="true"></div>
    <div class="cv-text cv-in cv-top">
      <p lang="hi" class="cv-inv">{copy.cover.invocation}</p>
      <p class="cv-for"><span lang="hi">{copy.cover.eyebrowDev}</span> · {copy.cover.eyebrow}</p>
      <span class="cv-guestname" data-guest-name>{copy.cover.guestDefault}</span>
    </div>
    <div class="seal-wrap cv-in">
      <span class="ring" aria-hidden="true"></span><span class="ring" aria-hidden="true"></span>
      <button type="button" class="seal" id="openBtn">
        <span class="glow" aria-hidden="true"></span>
        <span lang="mr" class="big">{copy.cover.seal}</span>
        <span class="small">{copy.cover.tap}</span>
      </button>
    </div>
    <div class="cv-text cv-in cv-bottom">
      <p id="cvTitle" class="cv-names"><span class="nm">{couple.groom.en}</span> <span class="amp">&amp;</span> <span class="nm">{couple.bride.en}</span></p>
      <span lang="hi" class="cv-dn">{couple.bothDev}</span>
      <span class="cv-date"><span data-dates-short>{dates.short}</span><i aria-hidden="true"></i>{venue.city}</span>
      <span class="cv-why">{copy.cover.why}</span>
    </div>
  </div>
</div>
