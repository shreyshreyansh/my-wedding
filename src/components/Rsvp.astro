---
// The RSVP. The static page is the no-code state; the edge switches #rsvp[data-rsvp] to form, replied or closed
// for a family's own link. It works without JavaScript: the form posts to /api/rsvp and comes back with a 303.
import Band from './Band.astro';
import { eventArt } from '../art/events';
import { letters } from '../art/decor';
import { copy, events, rsvp } from '../data/wedding';
const minus = '<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path class="ic" d="M6 12h12"/></svg>';
const plus = '<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path class="ic" d="M6 12h12M12 6v12"/></svg>';
const wa = '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.4-.3Z"/></svg>';
---
<section id="rsvp" class="paper" aria-labelledby="rsvpTitle" data-rsvp="nocode">
  <Band />
  <div class="rsvp">
    <div class="med" set:html={eventArt('blessing')}></div>
    <p class="eyebrow reveal" style="color:var(--deep)"><span lang="hi">{copy.rsvp.eyebrowDev}</span> · {copy.rsvp.eyebrow}</p>
    <h2 id="rsvpTitle" class="cal letters wave" set:html={letters(copy.rsvp.title)}></h2>

    <div class="r-nocode r-panel reveal">
      <p class="r-bad" data-badcode hidden>{copy.rsvp.badCode}</p>
      <p>{copy.rsvp.noCode}</p>
    </div>

    <form id="rsvpForm" class="r-form r-panel reveal" action="/api/rsvp" method="post">
      <p class="r-ask"><span data-guest-ask>{copy.rsvp.ask}</span></p>
      {events.map((ev) => (
        <div class="row" data-event={ev.id}>
          <div class="ev"><b>{ev.name.en}</b><i>{ev.short}</i></div>
          <div class="step">
            <button type="button" data-d="-1" aria-label={'One fewer guest for ' + ev.name.en} set:html={minus}></button>
            <input class="r-count" type="number" inputmode="numeric" name={'n_' + ev.id} id={'n-' + ev.id} min="0" max={rsvp.maxPerEvent} value="0" aria-label={'Guests for ' + ev.name.en}>
            <button type="button" data-d="1" aria-label={'One more guest for ' + ev.name.en} set:html={plus}></button>
          </div>
        </div>
      ))}
      <div class="field"><label for="rsvpName">{copy.rsvp.name}</label><input id="rsvpName" name="name" type="text" autocomplete="name" maxlength="80"></div>
      <div class="field"><label for="rsvpNote">{copy.rsvp.note}</label><textarea id="rsvpNote" name="note" rows="2" maxlength="500"></textarea></div>
      <div class="hp" aria-hidden="true"><label>Leave this empty <input name="website" type="text" tabindex="-1" autocomplete="off"></label></div>
      <input type="hidden" name="g" value="">
      <input type="hidden" name="t" value="">
      <input type="hidden" name="rid" value="">
      <button type="submit" class="btn btn-primary r-send"><span class="cal">{copy.rsvp.send}</span></button>
      <div class="r-failed" role="alert" hidden>
        <p>{copy.rsvp.failed}</p>
        <a class="btn btn-wa r-wa" href="https://wa.me/" target="_blank" rel="noopener"><Fragment set:html={wa} /><span>{copy.rsvp.whatsapp}</span></a>
        <button type="button" class="btn btn-line r-retry">{copy.rsvp.retry}</button>
      </div>
    </form>

    <div class="thanks r-thanks r-panel" tabindex="-1">
      <p lang="hi" class="cal dhanyavad">{copy.rsvp.thanksDev}</p>
      <p class="cal r-thanks-title">{copy.rsvp.thanks}</p>
      <ul class="r-summary" data-reply-summary></ul>
      <p class="r-seeyou">{copy.rsvp.seeYou}</p>
      <a class="btn btn-line r-change" href="#rsvp">{copy.rsvp.change}</a>
    </div>

    <div class="r-closed r-panel">
      <p>{copy.rsvp.closed}</p>
      <a class="btn btn-wa r-wa" href="https://wa.me/" target="_blank" rel="noopener"><Fragment set:html={wa} /><span>{copy.rsvp.whatsapp}</span></a>
    </div>
  </div>
</section>
