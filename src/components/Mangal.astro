---
// The blessing, at night: a frieze of lotuses from a Chamba painting, the Mangalashtak verse lit word by word.
import Art from './Art.astro';
import { verse } from '../art/decor';
import { copy, mangal } from '../data/wedding';
---
<section id="mangal" aria-labelledby="mgTitle">
  <div class="mg-frieze" aria-hidden="true"><Art id="lotus" crop="frieze" alt="" sizes="100vw" /></div>
  <div class="mg-inner">
    <p class="eyebrow reveal"><span lang="mr">{copy.mangal.eyebrowDev}</span> · {copy.mangal.eyebrow}</p>
    <h2 id="mgTitle" class="reveal">{copy.mangal.title} <em>{copy.mangal.titleEm}</em></h2>
    <div class="verse" lang="sa" id="verse" set:html={verse(mangal.verse, mangal.rivers)}></div>
    <p class="gloss reveal">{mangal.gloss}</p>
    <p lang="mr" class="savdhan" id="savdhan">{mangal.savdhan}</p>
  </div>
  <div class="mg-frieze flip" aria-hidden="true"><Art id="lotus" crop="frieze" alt="" sizes="100vw" /></div>
</section>
