---
// The names, set like the title page of a folio: his flush left, hers flush right, an italic & on a hairline.
// The falling antarpat reveals this page.
import { couple, copy, dates, venue } from '../data/wedding';
---
<section id="hero" aria-labelledby="heroTitle">
  <div class="h-in">
    <p class="h-eyebrow"><span lang="hi">॥ शुभ विवाह ॥</span><span>{copy.hero.eyebrow}</span></p>
    <h1 id="heroTitle" tabindex="-1" class="h-names" aria-label={couple.groom.en + ' and ' + couple.bride.en}>
      <span class="h-who his" aria-hidden="true">
        <span class="nm">{couple.groom.en}</span>
        <span class="h-sub"><span lang="hi" class="dn">{couple.groom.dev}</span></span>
      </span>
      <span class="h-amp" aria-hidden="true"><i></i><span>&amp;</span><i></i></span>
      <span class="h-who her" aria-hidden="true">
        <span class="nm">{couple.bride.en}</span>
        <span class="h-sub"><span lang="mr" class="dn">{couple.bride.dev}</span></span>
      </span>
    </h1>
    <div class="h-when">
      <span class="h-date" data-dates-long>{dates.long}</span>
      <span>{venue.full}</span>
    </div>
  </div>
</section>
