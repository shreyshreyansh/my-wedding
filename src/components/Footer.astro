---
// The last word: his family's chaupai and her family's Pali blessing, and the credits for every artwork on the page.
import art from '../data/art.json';
import { chaupai, metta, music } from '../data/wedding';
import { T, viewOf } from '../data/i18n';
const works = Object.values(art);
const t = T(viewOf(Astro.url));
---
<footer>
  <div class="foot">
    <p lang="hi" class="chaupai">{chaupai[0]}<br>{chaupai[1]}</p>
    <i class="leaf foot-leaf" aria-hidden="true"></i>
    <p class="chaupai metta"><span lang="pi">{metta.pi}</span><span class="metta-en">{t.footer.metta}</span></p>
    <p class="love">{t.footer.love}</p>
    {music.src && (music.title || music.credit) && <p class="credit">♪ {[music.title, music.credit].filter(Boolean).join(' · ')}</p>}
    <details class="credits">
      <summary>{t.footer.credits}</summary>
      <p>{t.footer.creditsNote}</p>
      <ul>
        {works.map((w) => <li><a href={w.page} target="_blank" rel="noopener"><b>{w.title}</b><span>{w.place}, {w.date}. {w.credit}. {w.licence === 'CC0' ? 'Public domain (CC0)' : w.licence.startsWith('CC BY') ? w.licence : 'Public domain'}.</span></a></li>)}
      </ul>
    </details>
  </div>
</footer>
