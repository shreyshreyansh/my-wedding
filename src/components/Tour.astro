---
// Two paintings to look into, one from his side (Bihar) and one from hers (Maharashtra). They stay on screen while
// you scroll, and the view glides to a detail of each, one line of text each, then back out to show them together.
// The tours are in src/data/tours.json and the paintings in src/data/art.json; "live" adds twinkling stars or
// flickering torches. Without the motion (Reduce Motion) it is simply the two paintings, the lines listed under them.
//
// The pair stands side by side or one above the other, whichever fills the stage more: side by side wins once the
// stage is wider than the square root of the two layouts' aspect ratios multiplied (a container query, below).
//
// The paintings are fetched a little larger than they show (130vw), so the details stay sharp as the view zooms in; a
// phone at 3x density gets the 1200 px files all the same, as a laptop does: the 1600 px ones cost it twice the memory.
import Art from './Art.astro';
import art from '../data/art.json';
import files from '../data/art-files.json';
import tours from '../data/tours.json';
import { T, num, viewOf } from '../data/i18n';

type Box = [number, number, number, number];
type Work = { title: string; short: string; short_mr: string; short_hi: string; side: 'his' | 'hers'; place: string; date: string; live?: { twinkle?: number[][]; fire?: number[][] } };
interface Props { id: keyof typeof tours }
const { id } = Astro.props;
const tour = tours[id] as { works: string[]; stops: { w?: number; box?: number[]; text: string; mr: string; hi: string }[] };
/* the words in the page's language (the English is also the mixed page's) */
const view = viewOf(Astro.url), t = T(view);
const say = (s: (typeof tour.stops)[number]) => (view === 'mr' || view === 'hi' ? s[view] : s.text);
const short = (w: Work) => (view === 'mr' || view === 'hi' ? w[`short_${view}`] : w.short);
const works = tour.works.map((w) => ({ id: w, a: (art as unknown as Record<string, Work>)[w], f: (files as Record<string, Record<string, { w: number; h: number }>>)[w].main }));
const ars = works.map((w) => w.f.w / w.f.h);
const G = 0.035;

/* side by side: the same height (1); stacked: the same width (1) */
const rowW = ars[0] + G + ars[1];
const row = [{ l: 0, t: 0, w: ars[0] / rowW, h: 1 }, { l: (ars[0] + G) / rowW, t: 0, w: ars[1] / rowW, h: 1 }];
const colH = 1 / ars[0] + G + 1 / ars[1];
const col = [{ l: 0, t: 0, w: 1, h: 1 / ars[0] / colH }, { l: 0, t: (1 / ars[0] + G) / colH, w: 1, h: 1 / ars[1] / colH }];
const AR = { row: rowW, col: 1 / colH };
/* each stop's box, from its painting's own fractions to the pair's */
const place = (layout: typeof row, s: (typeof tour.stops)[number]): Box => {
  if (s.w === undefined || !s.box) return [0, 0, 1, 1];
  const p = layout[s.w], [x, y, w, h] = s.box;
  return [p.l + x * p.w, p.t + y * p.h, w * p.w, h * p.h].map((n) => +n.toFixed(4)) as Box;
};
const boxes = { col: tour.stops.map((s) => place(col, s)), row: tour.stops.map((s) => place(row, s)) };
const flip = Math.sqrt(AR.row * AR.col);
const pct = (n: number) => (n * 100).toFixed(3) + '%';

/* the sparkles sit in the same places on every visit (a seeded random walk) */
const pieces = works.map((w, i) => {
  let seed = [...w.id].reduce((s, c) => s * 31 + c.charCodeAt(0), 7);
  const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
  const stars = (w.a.live?.twinkle ?? []).flatMap(([x, y, ww, hh]) => Array.from({ length: Math.max(3, Math.round(ww * hh * 60)) }, () => ({
    l: (x + rand() * ww) * 100, t: (y + rand() * hh) * 100, s: 5 + rand() * 9, d: 1.6 + rand() * 2.4, dl: -rand() * 4
  })));
  const vars = ['c', 'r'].flatMap((k) => { const p = (k === 'c' ? col : row)[i]; return [`--${k}l:${pct(p.l)}`, `--${k}t:${pct(p.t)}`, `--${k}w:${pct(p.w)}`, `--${k}h:${pct(p.h)}`]; }).join(';');
  return { ...w, stars, fires: w.a.live?.fire ?? [], vars };
});
const label = works.map((w) => (w.a.side === 'his' ? t.tour.his : t.tour.hers) + short(w.a)).join('  ·  ');
---
<div class="tour" id={'tour-' + id} data-tour={JSON.stringify(boxes.col)} data-tour-row={JSON.stringify(boxes.row)} style={'--stops:' + tour.stops.length}>
  <style is:inline set:html={`#tour-${id} .tour-art{--ar:${AR.col.toFixed(4)}}@container (min-aspect-ratio:${Math.round(flip * 1000)}/1000){#tour-${id} .tour-art{--ar:${AR.row.toFixed(4)};--layout:row}#tour-${id} .tour-piece{left:var(--rl);top:var(--rt);width:var(--rw);height:var(--rh)}}`} />
  <div class="tour-pin">
    <div class="tour-stage">
      <div class="tour-art pair">
        {pieces.map((p) => (
          <div class={'tour-piece is-' + p.a.side} style={p.vars}>
            <Art id={p.id as keyof typeof files} crop="main" sizes="(min-aspect-ratio: 6/5) 40vw, (min-resolution: 2.5dppx) 87vw, 130vw" />
            {p.stars.length > 0 && <span class="twinkles" aria-hidden="true">{p.stars.map((s) => <i style={`left:${s.l.toFixed(1)}%;top:${s.t.toFixed(1)}%;--s:${s.s.toFixed(0)}px;--d:${s.d.toFixed(2)}s;--dl:${s.dl.toFixed(2)}s`}></i>)}</span>}
            {p.fires.map(([x, y, s]) => <span class="fire" aria-hidden="true" style={`left:${x * 100}%;top:${y * 100}%` + (s ? `;--fs:${s * 100}%` : '')}></span>)}
          </div>
        ))}
      </div>
    </div>
    <div class="tour-caps">
      <p class="label tour-cap is-label">{label}</p>
      <ol class="tour-list">
        {tour.stops.map((s, i) => <li class="tour-cap"><b>{num(view, i + 1)} / {num(view, tour.stops.length)}</b> {say(s)}</li>)}
      </ol>
    </div>
  </div>
</div>
