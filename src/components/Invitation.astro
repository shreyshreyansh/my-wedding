---
// The invitation card in the family's words, in English, Marathi or Hindi, inside a jharokha. The switch is a CSS
// radio group: no JavaScript, no history entries. The edge pre-selects the family's language.
import Parts from './Parts.astro';
import { archTop } from '../art/sunrise';
import { copy, invitation } from '../data/wedding';
import { T, viewOf } from '../data/i18n';
import type { Block, Lang } from '../data/schema';
const langs = Object.keys(invitation) as Lang[];
const t = T(viewOf(Astro.url));
/* the children's plea (बाल मनुहार) sits in its own little box */
function groups(blocks: Block[]) {
  const out: (Block | Block[])[] = [];
  for (const b of blocks) {
    if (b.k.startsWith('manuhar')) {
      const last = out[out.length - 1];
      if (Array.isArray(last)) last.push(b); else out.push([b]);
    } else out.push(b);
  }
  return out;
}
---
<section id="invite" aria-labelledby="invTitle">
  <div class="inv">
    <p class="eyebrow reveal"><Parts parts={t.invite.eyebrow} /></p>
    <h2 id="invTitle" class="reveal" data-for-title>{t.invite.title}</h2>
    <fieldset class="inv-set">
      <legend class="sr-only">{t.invite.choose}</legend>
      {langs.map((l) => <input class="inv-radio sr-only" type="radio" name="invlang" id={'inv-' + l} value={l} checked={l === t.invite.card} />)}
      <div class="inv-tabs reveal">
        {langs.map((l) => <label for={'inv-' + l} lang={l} class={'t-' + l}>{invitation[l].label}</label>)}
      </div>
      <div class="inv-cards arch reveal">
        <Fragment set:html={archTop()} />
        <div class="arch-body">
          {langs.map((l) => (
            <article class={'inv-card c-' + l} lang={l}>
              <div class="inv-in">
                {groups(invitation[l].blocks).map((g) => Array.isArray(g)
                  ? <div class="manuhar-box"><p class="b-manuhar-head" lang="hi">{copy.invite.manuhar}</p>{g.map((b) => <p class={'b-' + b.k}>{b.t}</p>)}</div>
                  : <p class={'b-' + g.k}>{g.t}</p>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </fieldset>
  </div>
</section>
