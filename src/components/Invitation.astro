---
// The invitation card in the family's words, in English, Marathi or Hindi. The switch is a CSS radio group:
// no JavaScript, no history entries. The edge pre-selects the family's language.
import { copy, invitation } from '../data/wedding';
import type { Block, Lang } from '../data/schema';
const langs = Object.keys(invitation) as Lang[];
/* the children's plea (बाल मनुहार) sits in its own little box */
function groups(blocks: Block[]) {
  const out: (Block | Block[])[] = [];
  for (const b of blocks) {
    if (b.k.startsWith('manuhar')) {
      const last = out[out.length - 1];
      if (Array.isArray(last)) last.push(b); else out.push([b]);
    } else out.push(b);
  }
  return out;
}
---
<section id="invite" aria-labelledby="invTitle">
  <div class="inv">
    <p class="eyebrow reveal"><span lang="mr">{copy.invite.eyebrowDev}</span> · {copy.invite.eyebrow}</p>
    <h2 id="invTitle" class="reveal">{copy.invite.title}</h2>
    <fieldset class="inv-set">
      <legend class="sr-only">{copy.invite.choose}</legend>
      {langs.map((l) => <input class="inv-radio sr-only" type="radio" name="invlang" id={'inv-' + l} value={l} checked={l === 'en'} />)}
      <div class="inv-tabs reveal">
        {langs.map((l) => <label for={'inv-' + l} lang={l} class={'t-' + l}>{invitation[l].label}</label>)}
      </div>
      <div class="inv-cards reveal">
        {langs.map((l) => (
          <article class={'inv-card c-' + l} lang={l}>
            <div class="inv-in">
              {groups(invitation[l].blocks).map((g) => Array.isArray(g)
                ? <div class="manuhar-box"><p class="b-manuhar-head" lang="hi">{copy.invite.manuhar}</p>{g.map((b) => <p class={'b-' + b.k}>{b.t}</p>)}</div>
                : <p class={'b-' + g.k}>{g.t}</p>)}
            </div>
          </article>
        ))}
      </div>
    </fieldset>
  </div>
</section>
