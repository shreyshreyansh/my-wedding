---
// The celebrations, as plates in a folio: one painting each, with its museum label, and the day's details.
import Chapter from './Chapter.astro';
import { copy, events } from '../data/wedding';
---
<section id="schedule" aria-labelledby="schedTitle">
  <header class="sched-head">
    <p class="eyebrow reveal"><span lang="mr">{copy.schedule.eyebrowDev}</span> · {copy.schedule.eyebrow}</p>
    <h2 id="schedTitle" class="reveal">{copy.schedule.title} <em data-count-title>{copy.schedule.titleEm}</em></h2>
  </header>
  <div class="chapters">
    {events.map((ev, i) => <Chapter ev={ev} n={i + 1} />)}
  </div>
</section>
