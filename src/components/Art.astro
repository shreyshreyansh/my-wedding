---
// One museum artwork, as cut by scripts/art.mjs: AVIF at a few widths with a WebP fallback, and an optional
// second crop for wide screens. The credit for every work is in src/data/art.json (and on the page, in the footer).
import files from '../data/art-files.json';
import art from '../data/art.json';

type Set = { w: number; h: number; colour: string; lqip?: string; avif: [string, number, number][]; webp: [string, number, number][] };
interface Props {
  id: keyof typeof files;
  crop?: string;
  /** the crop for landscape screens */
  wide?: string;
  sizes?: string;
  class?: string;
  /** the first thing on screen: fetched first, never lazily */
  eager?: boolean;
  /** decorative when the words around it already say what it shows */
  alt?: string;
}
const { id, crop = 'tall', wide, sizes = '100vw', class: cls, eager = false, alt } = Astro.props;
const all = files[id] as Record<string, Set>;
const f = all[crop], w = wide ? all[wide] : null;
const srcset = (list: Set['avif']) => list.map(([u, wd]) => u + ' ' + wd + 'w').join(', ');
const LAND = '(min-aspect-ratio: 1/1)';
---
<picture class={cls} style={'--ph:' + f.colour + (f.lqip ? ';--lq:url(' + f.lqip + ')' : '')}>
  {w && <source media={LAND} type="image/avif" srcset={srcset(w.avif)} sizes={sizes} width={w.w} height={w.h} />}
  {w && <source media={LAND} type="image/webp" srcset={srcset(w.webp)} sizes={sizes} width={w.w} height={w.h} />}
  <source type="image/avif" srcset={srcset(f.avif)} sizes={sizes} />
  <img src={f.webp[0][0]} srcset={srcset(f.webp)} sizes={sizes} width={f.w} height={f.h} alt={alt ?? (art as Record<string, { alt: string }>)[id].alt}
    loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'sync' : 'async'} fetchpriority={eager ? 'high' : undefined} />
</picture>
