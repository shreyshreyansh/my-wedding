---
// Where we'll be, and the things to know. The venue card shows a little drawn map; tapping "Show the map" loads
// Google's map in its place (only then, so nothing of Google's loads for guests who don't). Then four round line
// icons: the weather, what to wear for each celebration (marked data-event, so the edge removes the ones a family
// isn't invited to), the way there, and the date to reply by.
import Parts from './Parts.astro';
import { icon, mapCard } from '../art/sunrise';
import { events, venue } from '../data/wedding';
import { T, viewOf } from '../data/i18n';
const t = T(viewOf(Astro.url));
const embed = 'https://www.google.com/maps?output=embed&q=' + encodeURIComponent(venue.full);
const arrow = '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path class="ic" d="M6 14 14 6M7 6h7v7"/></svg>';
const copyIc = '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><rect class="ic" x="7" y="7" width="9" height="10" rx="1.5"/><path class="ic" d="M4 13V4.5A1.5 1.5 0 0 1 5.5 3H12"/></svg>';
---
<section id="venue" class="sec vn" aria-labelledby="vnTitle">
  <p class="eyebrow reveal"><Parts parts={t.place.eyebrow} /></p>
  <h2 id="vnTitle" class="reveal">{t.place.title}</h2>
  <div class="vn-card reveal">
    <div class="vn-map" data-embed={embed} data-title={venue.full}>
      <Fragment set:html={mapCard()} />
      <button type="button" class="vn-show">{t.place.map}</button>
    </div>
    <div class="vn-info">
      <p class="vn-name">{t.venue}</p>
      <div class="vn-actions">
        <a class="btn btn-primary vn-btn" href={venue.maps} target="_blank" rel="noopener"><span>{t.place.open}</span><Fragment set:html={arrow} /></a>
        <button type="button" class="btn btn-line vn-btn vn-copy" data-copy={venue.full} data-done={t.place.copied}><span>{t.place.copy}</span><Fragment set:html={copyIc} /></button>
      </div>
    </div>
  </div>
</section>

<section id="know" class="sec kn" aria-labelledby="knTitle">
  <p class="eyebrow reveal"><Parts parts={t.know.eyebrow} /></p>
  <h2 id="knTitle" class="reveal">{t.know.title}</h2>
  <p class="lede reveal">{t.know.intro}</p>
  <ul class="kn-list">
    <li class="kn-item reveal"><span class="kn-ic" set:html={icon('weather', 34)}></span><h3>{t.know.weather[0]}</h3><p>{t.know.weather[1]}</p></li>
    <li class="kn-item reveal"><span class="kn-ic" set:html={icon('dress', 34)}></span><h3>{t.know.wear}</h3>
      <p>{events.map((ev) => <span class="kn-ev" data-event={ev.id}><b>{t.ev[ev.id].name}</b> {t.ev[ev.id].dress}</span>)}</p></li>
    <li class="kn-item reveal"><span class="kn-ic" set:html={icon('map', 34)}></span><h3>{t.know.way[0]}</h3><p>{t.know.way[1]}</p></li>
    <li class="kn-item reveal"><span class="kn-ic" set:html={icon('letter', 34)}></span><h3>{t.know.reply[0]}</h3><p><a href="#rsvp">{t.know.reply[1]}</a></p></li>
  </ul>
</section>
