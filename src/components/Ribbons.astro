---
import { ribbonTrack } from '../art/decor';
import { ribbons } from '../data/wedding';
---
<section id="ribbons" aria-label="Shubh vivah">
  <div class="ribbon rib-z" aria-hidden="true"><div class="track" id="trackZ" set:html={ribbonTrack(ribbons.zari)}></div></div>
  <div class="ribbon rib-m" aria-hidden="true"><div class="track" id="trackM" set:html={ribbonTrack(ribbons.paper)}></div></div>
</section>
