---
import { meetingScene } from '../art/peacock';
import { couple, copy } from '../data/wedding';
---
<section id="meeting" aria-label="The two peacocks meet">
  <div class="stage">
    <div class="half l silk" id="mL"></div>
    <div class="half r paper" id="mR"></div>
    <div class="caps">
      {copy.meeting.map((c) => <p class="cap"><span>{c}</span></p>)}
    </div>
    <svg id="meetSvg" viewBox="0 0 400 300" aria-hidden="true" set:html={meetingScene()}></svg>
    <div class="meet-names plate">
      <span class="cal nm write">{couple.groom.en} <span class="amp">&amp;</span> {couple.bride.en}</span>
      <span lang="hi" class="cal dn write">{couple.bothDev}</span>
    </div>
  </div>
</section>
