---
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/buttons.css';
import '../styles/cover.css';
import '../styles/hero.css';
import '../styles/through.css';
import '../styles/schedule.css';
import '../styles/mangal.css';
import '../styles/curtain.css';
import '../styles/rsvp.css';
import '../styles/invite.css';
import '../styles/controls.css';
import '../styles/footer.css';
import '../styles/gentle.css';
import Cover from '../components/Cover.astro';
import Hero from '../components/Hero.astro';
import Through from '../components/Through.astro';
import Schedule from '../components/Schedule.astro';
import Mangal from '../components/Mangal.astro';
import Countdown from '../components/Countdown.astro';
import Rsvp from '../components/Rsvp.astro';
import Footer from '../components/Footer.astro';
import Invitation from '../components/Invitation.astro';
import Controls from '../components/Controls.astro';
import SeoHead from '../components/SeoHead.astro';
import { assertComplete } from '../data/schema';
import { copy } from '../data/wedding';
import fonts from '../data/fonts.json';

assertComplete();
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<SeoHead />
{fonts.preload.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
<script is:inline>(function(d){var h=d.documentElement;if(!('noModule' in d.createElement('script')))return;h.className+=' js locked';var p=null;try{p=localStorage.getItem('sm-motion')}catch(e){}if(p==='gentle'||(p!=='full'&&window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches))h.className+=' still'})(document);</script>
</head>
<body>
<div id="akshata" aria-hidden="true"></div>

<Cover />
<Controls />

<main>
  <Hero />
  <Through />
  <Invitation />
  <Schedule />
  <Mangal />
  <div class="curtain">
    <Countdown />
    <Rsvp />
  </div>
</main>

<Footer />

<script type="application/json" id="labels" set:html={JSON.stringify({ knotBusy: copy.rites.knotBusy, rsvp: { send: copy.rsvp.send, sending: copy.rsvp.sending, none: copy.rsvp.none } })}></script>
<script is:inline>(function(){var d=document,h=d.documentElement,c=d.getElementById('cover');function un(){h.className=h.className.replace(/\s?locked/g,'')}if(!c){un();return}c.addEventListener('click',function(){if(window.__smBooted)return;un();if(c.parentNode)c.parentNode.removeChild(c)})})();</script>
<script>
  import '../scripts/main';
</script>
</body>
</html>
