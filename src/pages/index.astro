---
import '../styles/base.css';
import '../styles/textiles.css';
import '../styles/buttons.css';
import '../styles/cover.css';
import '../styles/hero.css';
import '../styles/ribbons.css';
import '../styles/meeting.css';
import '../styles/schedule.css';
import '../styles/mangal.css';
import '../styles/curtain.css';
import '../styles/rsvp.css';
import '../styles/footer.css';
import '../styles/gentle.css';
import Cover from '../components/Cover.astro';
import Hero from '../components/Hero.astro';
import Ribbons from '../components/Ribbons.astro';
import Meeting from '../components/Meeting.astro';
import Schedule from '../components/Schedule.astro';
import Mangal from '../components/Mangal.astro';
import Countdown from '../components/Countdown.astro';
import Rsvp from '../components/Rsvp.astro';
import Footer from '../components/Footer.astro';
import { assertComplete } from '../data/schema';
import { copy } from '../data/wedding';

assertComplete();
---
<!doctype html>
<html lang="en" data-knot-busy={copy.rites.knotBusy}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Shreyansh & Mrunalini</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amita:wght@400;700&amp;family=Tiro+Devanagari+Hindi:ital@0;1&amp;family=Tiro+Devanagari+Marathi:ital@0;1&amp;display=swap">
<script is:inline>(function(d){var h=d.documentElement;if(!('noModule' in d.createElement('script')))return;h.className+=' js locked';var p=null;try{p=localStorage.getItem('sm-motion')}catch(e){}if(p==='gentle'||(p!=='full'&&window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches))h.className+=' still'})(document);</script>
</head>
<body>
<div class="selv l zari" aria-hidden="true"></div>
<div class="selv r hatch" aria-hidden="true"></div>
<div id="progress" aria-hidden="true"></div>
<div id="akshata" aria-hidden="true"></div>

<Cover />

<main>
  <Hero />
  <Ribbons />
  <Meeting />
  <Schedule />
  <Mangal />
  <div class="curtain">
    <Countdown />
    <Rsvp />
  </div>
</main>

<Footer />

<script is:inline>(function(){var d=document,h=d.documentElement,c=d.getElementById('cover');function un(){h.className=h.className.replace(/\s?locked/g,'')}if(!c){un();return}c.addEventListener('click',function(){if(window.__smBooted)return;un();if(c.parentNode)c.parentNode.removeChild(c)})})();</script>
<script>
  import '../scripts/main';
</script>
</body>
</html>
