---
// Tooling only (removed from dist after the build): the 1200×630 link-preview card and the app icon,
// photographed by scripts/og.mjs. The medallion and names sit in the centre square, which WhatsApp may crop to.
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/textiles.css';
import { medallion } from '../art/peacock';
import { couple, dates, venue } from '../data/wedding';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex">
<title>card</title>
<style>
  body{margin:0;background:#2B211B}
  #card{position:relative;width:1200px;height:630px;overflow:hidden;display:flex;flex-direction:column;align-items:center}
  #card .half{position:absolute;top:0;bottom:0;width:50%}
  #card .l{left:0}#card .r{right:0}
  #card .edge{position:absolute;top:0;bottom:0;width:22px}
  #card .edge.l{left:0}#card .edge.r{right:0;border-left:2px solid var(--kajal)}
  #card .inv{position:relative;margin:24px 0 0;padding:2px 14px;background:var(--kajal);color:var(--chuna);font-size:20px}
  #card .med{position:relative;width:330px;height:330px;margin-top:8px}
  #card .med svg{display:block;width:100%;height:100%}
  #card .names{position:relative;margin-top:12px;padding:10px 28px 12px;background:var(--kajal);color:var(--chuna);text-align:center;box-shadow:0 0 0 3px var(--zari)}
  #card .nm{font-family:Amita,serif;font-weight:700;font-size:52px;line-height:1.1;margin:0}
  #card .nm span{color:var(--zari)}
  #card .dn{font-family:Amita,serif;font-size:28px;color:var(--zari);line-height:1.3}
  #card .date{position:relative;margin-top:14px;font-size:22px;font-style:italic;color:var(--kajal);background:var(--kagaz);padding:2px 14px}
  #icon{width:512px;height:512px;display:grid;place-items:center;background:var(--kagaz)}
  #icon svg{width:480px;height:480px}
</style>
</head>
<body>
<div id="card">
  <div class="half l silk"></div><div class="half r paper"></div>
  <div class="edge l zari"></div><div class="edge r hatch"></div>
  <p class="inv" lang="hi">॥ श्री गणेशाय नमः ॥</p>
  <div class="med" set:html={medallion('garland', 'closed')}></div>
  <div class="names"><p class="nm">{couple.groom.en} <span>&amp;</span> {couple.bride.en}</p><div class="dn" lang="hi">{couple.bothDev}</div></div>
  <p class="date">{dates.short} · {venue.city}</p>
</div>
<div id="icon" set:html={medallion('apart', 'none')}></div>
</body>
</html>
