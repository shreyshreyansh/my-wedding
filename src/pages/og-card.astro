---
// Tooling only (removed from dist after the build): the 1200×630 link-preview card and the app icon,
// photographed by scripts/og.mjs. The names sit in the centre square, which WhatsApp may crop to.
import '../styles/fonts.css';
import '../styles/base.css';
import files from '../data/art-files.json';
import { couple, dates, venue } from '../data/wedding';
const wide = files.silk.wide.avif[0][0], tall = files.silk.tall.avif[1][0];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex">
<title>card</title>
<style>
  body{margin:0;background:#1A1220}
  #card{position:relative;width:1200px;height:630px;overflow:hidden;color:#F4EEE3;text-align:center}
  #card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  #card .shade{position:absolute;inset:0;background:radial-gradient(ellipse 360px 300px at 50% 50%,rgba(26,18,32,.9) 0,rgba(26,18,32,.78) 55%,rgba(26,18,32,.25) 100%)}
  #card .in{position:absolute;left:285px;top:0;width:630px;height:630px;display:flex;flex-direction:column;align-items:center;justify-content:center}
  #card .inv{margin:0 0 14px;font-size:20px;color:#F2DFA2}
  #card .nm{margin:0;font-family:var(--display);font-size:104px;line-height:.86;letter-spacing:-.01em}
  #card .amp{display:block;font-style:italic;font-size:52px;line-height:1.1;color:#F2DFA2}
  #card .dn{margin-top:14px;font-size:30px;color:#D8B46A}
  #card .date{margin-top:14px;font-size:17px;letter-spacing:.18em;text-transform:uppercase}
  #icon{width:512px;height:512px;background-color:#8E1A50;background-repeat:no-repeat;background-size:1047px auto;background-position:-257px -986px}
</style>
</head>
<body>
<div id="card">
  <img src={wide} alt="">
  <div class="shade"></div>
  <div class="in">
    <p class="inv" lang="hi">॥ श्री गणेशाय नमः ॥</p>
    <p class="nm">{couple.groom.en}<span class="amp">&amp;</span>{couple.bride.en}</p>
    <div class="dn" lang="hi">{couple.bothDev}</div>
    <div class="date">{dates.short} · {venue.city}</div>
  </div>
</div>
<div id="icon" style={'background-image:url(' + tall + ')'}></div>
</body>
</html>
